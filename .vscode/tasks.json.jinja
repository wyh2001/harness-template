{
  "version": "2.0.0",
  "tasks": [
{% if swift_app_stack | default('none') == 'ios' %}
    {
      "label": "xcode: generate",
      "type": "shell",
      "command": "xcodegen generate --spec {{ swift_project_spec_path }}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "simulator: create fixed device",
      "type": "shell",
      "command": "./scripts/simulator.mjs create",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "test: unit",
      "type": "shell",
      "command": "./scripts/test.mjs unit",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "test: ui",
      "type": "shell",
      "command": "./scripts/test.mjs ui",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
{% endif %}
    {
      "label": "dev: {% if swift_app_stack | default('none') == 'ios' and backend_stack == 'none' and frontend_stack == 'none' %}open Xcode{% else %}start full stack{% endif %}",
      "type": "shell",
      "command": "./scripts/dev.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "dev: check health",
      "type": "shell",
      "command": "./scripts/check-health.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "smoke",
      "type": "shell",
      "command": "./scripts/smoke.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
{% if include_api_contract | default(false) %}
    {
      "label": "generate api contract",
      "type": "shell",
      "command": "./scripts/generate-api-contract.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
{% endif %}
{% if include_playwright_e2e | default(false) %}
    {
      "label": "test:e2e:impact:validate",
      "type": "shell",
      "command": "node scripts/validate-playwright-impact-tags.mjs --strict",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "test:e2e",
      "type": "shell",
      "command": "pnpm --dir {{ frontend_dir }} test:e2e",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
{% endif %}
    {
      "label": "validate changed scope",
      "type": "shell",
      "command": "./scripts/validate-changed-scope.mjs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": {% if backend_stack == 'rust' %}["$rustc"]{% else %}[]{% endif %},
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "finalize",
      "type": "shell",
      "command": "./scripts/finalize.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": {% if backend_stack == 'rust' %}["$rustc"]{% else %}[]{% endif %},
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
