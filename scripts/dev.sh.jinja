#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

{% if backend_stack != 'none' -%}
API_HOST="${API_HOST:-{{ api_host }}}"
API_PORT="${API_PORT:-{{ api_port }}}"
API_BASE_URL="http://${API_HOST}:${API_PORT}"
{% endif -%}
{% if frontend_stack != 'none' -%}
FRONTEND_HOST="${FRONTEND_HOST:-{{ frontend_host }}}"
FRONTEND_PORT="${FRONTEND_PORT:-{{ frontend_port }}}"
FRONTEND_BASE_URL="http://${FRONTEND_HOST}:${FRONTEND_PORT}"
{% endif %}

PIDS=()

check_children_alive() {
  local pid

  for pid in "${PIDS[@]}"; do
    if ! kill -0 "${pid}" >/dev/null 2>&1; then
      wait "${pid}" || true
      exit 1
    fi
  done
}

check_port_free() {
  local label="$1"
  local port="$2"

  if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1; then
    printf '%s port %s is already in use. Stop that process or choose another port.\n' "${label}" "${port}" >&2
    lsof -nP -iTCP:"${port}" -sTCP:LISTEN >&2
    exit 1
  fi
}

wait_for_text() {
  local label="$1"
  local url="$2"
  local expected="$3"

  printf 'Waiting for %s: %s\n' "${label}" "${url}"

  for _ in {1..60}; do
    check_children_alive

    if curl --fail --silent "${url}" | grep --quiet "${expected}"; then
      printf '%s ready.\n' "${label}"
      return
    fi

    sleep 1
  done

  printf 'Timed out waiting for %s.\n' "${label}" >&2
  exit 1
}

cleanup() {
  local pid

  for pid in "${PIDS[@]}"; do
    if kill -0 "${pid}" >/dev/null 2>&1; then
      kill "${pid}" >/dev/null 2>&1 || true
    fi
  done

  for pid in "${PIDS[@]}"; do
    wait "${pid}" >/dev/null 2>&1 || true
  done
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

{% if backend_stack != 'none' -%}
check_port_free "API" "${API_PORT}"
{% endif -%}
{% if frontend_stack != 'none' -%}
check_port_free "Frontend" "${FRONTEND_PORT}"
{% endif %}

{% if backend_stack == 'rust' -%}
printf 'Starting API at %s\n' "${API_BASE_URL}"
(
  cd "${REPO_ROOT}"
  PORT="${API_PORT}" \
    RUST_LOG="${RUST_LOG:-{{ project_slug | replace('-', '_') }}_api=debug,tower_http=info}" \
    exec cargo run -p {{ rust_api_package }}
) &
PIDS+=("$!")

{% elif backend_stack == 'dotnet' -%}
printf 'Starting API at %s\n' "${API_BASE_URL}"
(
  cd "${REPO_ROOT}"
  ASPNETCORE_ENVIRONMENT=Development \
    ASPNETCORE_URLS="${API_BASE_URL}" \
    exec dotnet run --project "{{ dotnet_api_project_path }}"
) &
PIDS+=("$!")

{% endif -%}
{% if frontend_stack == 'vite' -%}
printf 'Starting frontend at %s\n' "${FRONTEND_BASE_URL}"
(
  cd "${REPO_ROOT}"
{% if backend_stack != 'none' -%}
  VITE_API_BASE_URL="${API_BASE_URL}" \
{% endif -%}
    exec pnpm --dir {{ frontend_dir }} dev --host "${FRONTEND_HOST}" --port "${FRONTEND_PORT}"
) &
PIDS+=("$!")

{% elif frontend_stack == 'astro' -%}
printf 'Starting frontend at %s\n' "${FRONTEND_BASE_URL}"
(
  cd "${REPO_ROOT}"
{% if backend_stack != 'none' -%}
  PUBLIC_API_BASE_URL="${API_BASE_URL}" \
{% endif -%}
    exec pnpm --dir {{ frontend_dir }} exec astro dev --host "${FRONTEND_HOST}" --port "${FRONTEND_PORT}"
) &
PIDS+=("$!")

{% endif -%}
{% if backend_stack != 'none' -%}
wait_for_text "API health" "${API_BASE_URL}{{ api_health_path }}" "{{ api_health_text }}"
{% endif -%}
{% if frontend_stack != 'none' -%}
wait_for_text "Frontend home" "${FRONTEND_BASE_URL}/" "{{ frontend_health_text }}"
{% endif %}

{% if frontend_stack != 'none' -%}
printf '\nPreview: %s\n' "${FRONTEND_BASE_URL}"
{% endif -%}
{% if backend_stack != 'none' -%}
printf 'API health: %s{{ api_health_path }}\n' "${API_BASE_URL}"
{% endif -%}
{% if include_api_contract | default(false) and backend_stack != 'none' -%}
printf 'OpenAPI contract check: ./scripts/check-api-contract.sh\n'
{% endif -%}
printf 'Press Ctrl+C to stop the dev stack.\n'

while true; do
  check_children_alive
  sleep 1
done
