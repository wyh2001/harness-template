#!/usr/bin/env bash
set -euo pipefail

run_markdownlint() {
  if command -v markdownlint-cli2 >/dev/null 2>&1; then
    markdownlint-cli2 "$@"
    return
  fi

  if command -v pnpm >/dev/null 2>&1; then
    pnpm dlx markdownlint-cli2 "$@"
    return
  fi

  if command -v npx >/dev/null 2>&1; then
    npx -y markdownlint-cli2 "$@"
    return
  fi

  printf 'markdownlint-cli2 is required. Install it, or install Node.js with pnpm/npx available.\n' >&2
  exit 1
}

run_markdownlint "AGENTS.md" "README.md" "docs/**/*.md"
