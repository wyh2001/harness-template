#!/usr/bin/env node

import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { buildDecision, collectE2eSpecMetadata } from './select-playwright-impact-tests.mjs';
{% if swift_app_stack | default('none') == 'ios' and include_xctest_impact_selection | default(false) %}
import { buildXCTestImpactDecision } from './select-xctest-impact-tests.mjs';
{% endif %}

{% set changed_scope_frontend_dir = frontend_dir | default('frontend') -%}
{% set changed_scope_e2e_test_dir = e2e_test_dir | default(changed_scope_frontend_dir ~ '/e2e') -%}
const scriptDir = path.dirname(fileURLToPath(import.meta.url));
const workspaceRoot = path.resolve(scriptDir, '..');
const backendStack = '{{ backend_stack | default("none") }}';
const frontendStack = '{{ frontend_stack | default("none") }}';
const swiftAppStack = '{{ swift_app_stack | default("none") }}';
const frontendDir = '{{ changed_scope_frontend_dir }}';
const e2eTestDir = '{{ changed_scope_e2e_test_dir }}';
const includeApiContract = {% if include_api_contract | default(false) %}true{% else %}false{% endif %};
const includeLayeringValidator = {% if include_layering_validator | default(false) %}true{% else %}false{% endif %};
const includePlaywrightE2e = {% if include_playwright_e2e | default(false) %}true{% else %}false{% endif %};
const includeSwiftFormat = {% if include_swift_format | default(true) %}true{% else %}false{% endif %};
const includeSwiftLint = {% if include_swiftlint | default(false) %}true{% else %}false{% endif %};
const includeXCTestImpactSelection = {% if include_xctest_impact_selection | default(false) %}true{% else %}false{% endif %};
const swiftSourceDir = '{{ swift_source_dir | default("Sources") }}';
const swiftProjectSpecPath = '{{ swift_project_spec_path | default("project.yml") }}';
const swiftUnitTestTarget = '{{ swift_unit_test_target | default("AppTests") }}';
const swiftUiTestTarget = '{{ swift_ui_test_target | default("AppUITests") }}';
const dotnetSolutionPath = '{{ dotnet_solution_path | default("backend/App.slnx") }}';
const apiContractPath = '{% if backend_stack == "dotnet" %}{{ dotnet_openapi_contract_path | default("") }}{% else %}{{ openapi_contract_path | default("generated/openapi.json") }}{% endif %}';
const frontendSchemaPath = '{{ frontend_schema_path | default("") }}';

const ignoredPathSegments = new Set([
  '.git',
  'node_modules',
  'target',
  'dist',
  'build',
  'coverage',
  'playwright-report',
  'test-results',
  'bin',
  'obj',
]);

function parseArgs(argv) {
  const options = {
    dryRun: false,
    explicitFiles: [],
    json: false,
    since: null,
    skipE2e: false,
    skipUiTests: false,
  };

  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === '--dry-run') {
      options.dryRun = true;
      continue;
    }
    if (arg === '--json') {
      options.json = true;
      continue;
    }
    if (arg === '--skip-e2e') {
      options.skipE2e = true;
      continue;
    }
    if (arg === '--skip-ui-tests') {
      options.skipUiTests = true;
      continue;
    }
    if (arg === '--since') {
      const value = argv[index + 1];
      if (!value) {
        throw new Error('--since requires a git ref.');
      }
      options.since = value;
      index += 1;
      continue;
    }
    if (arg.startsWith('-')) {
      throw new Error(`Unknown argument '${arg}'.`);
    }

    options.explicitFiles.push(arg);
  }

  return options;
}

function normalizePath(filePath) {
  return filePath.replaceAll(path.sep, '/').replace(/^\.\//, '');
}

function gitOutput(args) {
  const result = spawnSync('git', args, {
    cwd: workspaceRoot,
    encoding: 'utf8',
  });

  if (result.status !== 0) {
    throw new Error(result.stderr.trim() || `git ${args.join(' ')} failed`);
  }

  return result.stdout;
}

function parseNameStatus(output) {
  const fields = output.split('\0');
  const changes = [];
  for (let index = 0; index < fields.length;) {
    const status = fields[index++];
    if (!status) continue;
    if (status.startsWith('R') || status.startsWith('C')) {
      const previousPath = normalizePath(fields[index++] ?? '');
      const currentPath = normalizePath(fields[index++] ?? '');
      if (currentPath) changes.push({ path: currentPath, previousPath, status });
    } else {
      const currentPath = normalizePath(fields[index++] ?? '');
      if (currentPath) changes.push({ path: currentPath, status });
    }
  }
  return changes;
}

function gitHasHead() {
  return spawnSync('git', ['rev-parse', '--verify', 'HEAD'], {
    cwd: workspaceRoot,
    stdio: 'ignore',
  }).status === 0;
}

function collectChanges(options) {
  const trackedChanges = options.since || gitHasHead()
    ? parseNameStatus(gitOutput(['diff', '--name-status', '-z', '--find-renames', options.since ?? 'HEAD', '--']))
    : gitOutput(['ls-files', '-z'])
        .split('\0')
        .filter(Boolean)
        .map((filePath) => ({ path: normalizePath(filePath), status: 'A' }));
  const rawChanges = options.explicitFiles.length > 0
    ? options.explicitFiles.map((filePath) => ({ path: normalizePath(filePath), status: 'E' }))
    : [
        ...trackedChanges,
        ...gitOutput(['ls-files', '--others', '--exclude-standard', '-z'])
          .split('\0')
          .filter(Boolean)
          .map((filePath) => ({ path: normalizePath(filePath), status: 'A?' })),
      ];

  const byPath = new Map();
  for (const change of rawChanges) {
    if (!change.path || change.path.split('/').some((segment) => ignoredPathSegments.has(segment))) continue;
    byPath.set(change.path, {
      ...change,
      exists: fs.existsSync(path.join(workspaceRoot, change.path)),
    });
  }
  return [...byPath.values()].sort((left, right) => left.path.localeCompare(right.path));
}

function changedFilesFor(changes) {
  return [...new Set(changes.flatMap((change) => [change.path, change.previousPath]).filter(Boolean))].sort();
}

function toRepoRelative(fullPath) {
  const relativePath = path.relative(workspaceRoot, fullPath).replaceAll(path.sep, '/');
  return relativePath === '' ? '.' : relativePath;
}

function pathExists(repoPath) {
  return fs.existsSync(path.join(workspaceRoot, repoPath));
}

function readPackageScripts(packageJsonPath) {
  const fullPath = path.join(workspaceRoot, packageJsonPath);
  if (!fs.existsSync(fullPath)) {
    return {};
  }

  try {
    return JSON.parse(fs.readFileSync(fullPath, 'utf8')).scripts ?? {};
  } catch (error) {
    throw new Error(`Could not parse ${packageJsonPath}: ${error.message}`);
  }
}

function hasCommand(command) {
  return spawnSync(command, ['--version'], { cwd: workspaceRoot, stdio: 'ignore' }).status === 0;
}

function hasAnyChangedFile(changedFiles, predicate) {
  return changedFiles.some(predicate);
}

function escapeRegExp(value) {
  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function matchesAny(repoPath, patterns) {
  return patterns.some((pattern) => pattern.test(repoPath));
}

function shellQuote(value) {
  return /^[A-Za-z0-9_./:@%+=,-]+$/.test(value) ? value : `'${value.replaceAll("'", "'\\''")}'`;
}

function formatCommand(command) {
  const commandText = [command.command, ...command.args].map(shellQuote).join(' ');
  if (command.cwd === workspaceRoot) {
    return commandText;
  }

  return `cd ${shellQuote(toRepoRelative(command.cwd))} && ${commandText}`;
}

function makeCommand(label, command, args, options = {}) {
  const task = {
    args,
    command,
    cwd: options.cwd ?? workspaceRoot,
    label,
    reason: options.reason ?? '',
  };

  return {
    ...task,
    display: formatCommand(task),
  };
}

function addCommand(commands, label, command, args, options = {}) {
  commands.push(makeCommand(label, command, args, options));
}

function addSkip(skipped, label, reason) {
  skipped.push({ label, reason });
}

function addFrontendScriptCommand(commands, skipped, scripts, scriptName, label, reason, extraArgs = []) {
  if (frontendStack === 'none') {
    return;
  }

  if (!pathExists(`${frontendDir}/package.json`)) {
    addSkip(skipped, label, `${frontendDir}/package.json does not exist yet`);
    return;
  }

  if (!scripts[scriptName]) {
    addSkip(skipped, label, `${frontendDir}/package.json has no ${scriptName} script`);
    return;
  }

  addCommand(commands, label, 'pnpm', ['--dir', frontendDir, scriptName, ...extraArgs], { reason });
}

function addPlaywrightExecCommand(commands, skipped, label, args, reason) {
  if (!pathExists(`${frontendDir}/package.json`)) {
    addSkip(skipped, label, `${frontendDir}/package.json does not exist yet`);
    return;
  }

  addCommand(commands, label, 'pnpm', ['--dir', frontendDir, 'exec', 'playwright', 'test', ...args], { reason });
}

function isFrontendPath(repoPath) {
  return frontendStack !== 'none' && repoPath.startsWith(`${frontendDir}/`);
}

function isFrontendSourceOrTestPath(repoPath) {
  return isFrontendPath(repoPath) && /\.(astro|svelte|tsx?|jsx?|css|scss|sass)$/.test(repoPath);
}

function isFrontendTestPath(repoPath) {
  return isFrontendPath(repoPath) && /\.(test|spec)\.(tsx?|jsx?)$/.test(repoPath);
}

function isFrontendConfigPath(repoPath) {
  return (
    isFrontendPath(repoPath) &&
    /(^|\/)(package\.json|pnpm-lock\.yaml|vite\.config\.|astro\.config\.|playwright\.config\.|tsconfig)/.test(repoPath)
  );
}

function isRustBackendPath(repoPath) {
  return backendStack === 'rust' && (repoPath === 'Cargo.toml' || repoPath === 'Cargo.lock' || repoPath.startsWith('crates/'));
}

function isDotnetBackendPath(repoPath) {
  return backendStack === 'dotnet' && (repoPath.startsWith('backend/') || /\.(sln|slnx)$/.test(repoPath));
}

function isUnderDir(repoPath, directory) {
  return repoPath === directory || repoPath.startsWith(`${directory}/`);
}

function isSwiftSourceOrTestPath(repoPath) {
  return (
    swiftAppStack === 'ios' &&
    repoPath.endsWith('.swift') &&
    (isUnderDir(repoPath, swiftSourceDir) ||
      isUnderDir(repoPath, swiftUnitTestTarget) ||
      isUnderDir(repoPath, swiftUiTestTarget))
  );
}

function isSwiftUiTestPath(repoPath) {
  return swiftAppStack === 'ios' && repoPath.endsWith('.swift') && isUnderDir(repoPath, swiftUiTestTarget);
}

function isSwiftProjectMetadataPath(repoPath) {
  return (
    swiftAppStack === 'ios' &&
    (repoPath === swiftProjectSpecPath ||
      repoPath === '.swift-format' ||
      repoPath === '.swiftlint.yml' ||
      repoPath.endsWith('/Package.resolved'))
  );
}

function isXCTestImpactGovernancePath(repoPath) {
  return [
    'scripts/xctest-impact-rules.mjs',
    'scripts/select-xctest-impact-tests.mjs',
    'scripts/validate-xctest-impact-rules.mjs',
    'scripts/test.mjs',
    'docs/tasks/ios-testing.md',
  ].includes(repoPath);
}

function isGovernancePath(repoPath) {
  return (
    repoPath === 'AGENTS.md' ||
    repoPath === 'README.md' ||
    repoPath.startsWith('docs/') ||
    repoPath.startsWith('scripts/') ||
    repoPath.startsWith('.agents/') ||
    repoPath.startsWith('.github/workflows/') ||
    repoPath.startsWith('.vscode/') ||
    repoPath === '.markdownlint-cli2.jsonc' ||
    repoPath === 'copier.yml'
  );
}

function isMarkdownPath(repoPath) {
  return repoPath === 'AGENTS.md' || repoPath === 'README.md' || repoPath.endsWith('.md');
}

function isSpecOrTraceabilityPath(repoPath) {
  return (
    (repoPath.startsWith('docs/specs/') && repoPath.endsWith('.md')) ||
    repoPath === 'docs/SPEC_TEMPLATE.md' ||
    repoPath === 'docs/TRACEABILITY_GUIDE.md' ||
    repoPath === 'scripts/validate-traceability-structure.mjs'
  );
}

function isPlaywrightImpactGovernancePath(repoPath) {
  const e2eSpecPattern = new RegExp(`^${escapeRegExp(e2eTestDir)}/.*\\.(spec|test)\\.(mjs|js|ts|tsx|jsx)$`);
  return (
    e2eSpecPattern.test(repoPath) ||
    repoPath === 'scripts/playwright-impact-rules.mjs' ||
    repoPath === 'scripts/select-playwright-impact-tests.mjs' ||
    repoPath === 'scripts/validate-playwright-impact-tags.mjs' ||
    repoPath === 'scripts/tests/validate-playwright-impact-tags-smoke.sh' ||
    repoPath === 'docs/specs/playwright-e2e-impact-tags.md' ||
    repoPath === 'docs/status/playwright-e2e-impact-tag-baseline.json'
  );
}

function buildPlan(changedFiles, changes, options) {
  const commands = [];
  const skipped = [];
  const frontendScripts = readPackageScripts(`${frontendDir}/package.json`);
  const frontendChanged = hasAnyChangedFile(changedFiles, isFrontendPath);
  const frontendSourceChanged = hasAnyChangedFile(changedFiles, isFrontendSourceOrTestPath);
  const frontendTestChanged = hasAnyChangedFile(changedFiles, isFrontendTestPath);
  const frontendConfigChanged = hasAnyChangedFile(changedFiles, isFrontendConfigPath);
  const rustBackendChanged = hasAnyChangedFile(changedFiles, isRustBackendPath);
  const dotnetBackendChanged = hasAnyChangedFile(changedFiles, isDotnetBackendPath);
  const swiftSourceOrTestChanged = hasAnyChangedFile(changedFiles, isSwiftSourceOrTestPath);
  const swiftUiTestChanged = hasAnyChangedFile(changedFiles, isSwiftUiTestPath);
  const swiftProjectMetadataChanged = hasAnyChangedFile(changedFiles, isSwiftProjectMetadataPath);
  const xctestImpactGovernanceChanged =
    includeXCTestImpactSelection && hasAnyChangedFile(changedFiles, isXCTestImpactGovernancePath);
  const governanceChanged = hasAnyChangedFile(changedFiles, isGovernancePath);
  const specOrTraceabilityChanged = hasAnyChangedFile(changedFiles, isSpecOrTraceabilityPath);
  const playwrightImpactGovernanceChanged = includePlaywrightE2e && hasAnyChangedFile(changedFiles, isPlaywrightImpactGovernancePath);
  const layeringRulesChanged = changedFiles.some(
    (repoPath) => repoPath === 'docs/specs/architecture-layering-v0.1.md' || repoPath === 'scripts/validate-layering.mjs',
  );
  const contractFilesChanged = changedFiles.some(
    (repoPath) =>
      repoPath === apiContractPath ||
      repoPath === frontendSchemaPath ||
      repoPath.includes('openapi') ||
      repoPath.includes('schema'),
  );
  const contractFilesExist = [apiContractPath, frontendSchemaPath].filter(Boolean).some(pathExists);
  const markdownChanged = hasAnyChangedFile(changedFiles, isMarkdownPath);
  const shellScriptsChanged = changedFiles.filter((repoPath) => repoPath.startsWith('scripts/') && repoPath.endsWith('.sh'));
  const nodeScriptsChanged = changedFiles.filter((repoPath) => repoPath.startsWith('scripts/') && repoPath.endsWith('.mjs'));
{% if swift_app_stack | default('none') == 'ios' and include_xctest_impact_selection | default(false) %}
  const xctestImpact = buildXCTestImpactDecision(changes, workspaceRoot);
  if (xctestImpact.errors.length > 0) {
    throw new Error(
      `XCTest impact selection requires maintenance:\n${xctestImpact.errors.map((error) => `- ${error}`).join('\n')}`,
    );
  }
{% else %}
  const xctestImpact = null;
{% endif %}

  if (frontendChanged || frontendSourceChanged || frontendConfigChanged) {
    addFrontendScriptCommand(
      commands,
      skipped,
      frontendScripts,
      'format:check',
      'frontend-format',
      'frontend files changed',
    );

    if (frontendStack === 'astro') {
      addFrontendScriptCommand(commands, skipped, frontendScripts, 'check', 'frontend-check', 'Astro frontend files changed');
    } else {
      addFrontendScriptCommand(commands, skipped, frontendScripts, 'lint', 'frontend-lint', 'frontend files changed');
    }
  }

  if (frontendSourceChanged || frontendTestChanged) {
    const frontendFiles = changedFiles.filter(isFrontendPath);
    if (frontendScripts['test:related']) {
      addFrontendScriptCommand(
        commands,
        skipped,
        frontendScripts,
        'test:related',
        'frontend-related-tests',
        'frontend source or tests changed',
        ['--', ...frontendFiles],
      );
    } else if (frontendTestChanged) {
      addFrontendScriptCommand(commands, skipped, frontendScripts, 'test', 'frontend-tests', 'frontend test files changed');
    } else {
      addSkip(skipped, 'frontend-related-tests', 'add a test:related script to select tests from changed source files');
    }
  }

  if (playwrightImpactGovernanceChanged) {
    if (frontendScripts['test:e2e:impact:validate']) {
      addFrontendScriptCommand(
        commands,
        skipped,
        frontendScripts,
        'test:e2e:impact:validate',
        'playwright-impact-tags',
        'Playwright specs or impact governance changed',
      );
    } else if (pathExists('scripts/validate-playwright-impact-tags.mjs')) {
      addCommand(commands, 'playwright-impact-tags', 'node', ['scripts/validate-playwright-impact-tags.mjs', '--strict'], {
        reason: 'Playwright specs or impact governance changed',
      });
    }
  }

  if (includePlaywrightE2e && !options.skipE2e) {
    const e2eDecision = buildDecision(changedFiles, collectE2eSpecMetadata());
    if (e2eDecision.fullE2e) {
      if (frontendScripts['test:e2e']) {
        addFrontendScriptCommand(
          commands,
          skipped,
          frontendScripts,
          'test:e2e',
          'playwright-e2e-full',
          'changed files require full Playwright fallback',
        );
      } else {
        addPlaywrightExecCommand(commands, skipped, 'playwright-e2e-full', [], 'changed files require full Playwright fallback');
      }
    } else {
      if (e2eDecision.impactTags.length > 0 && e2eDecision.tagBackfillComplete) {
        addPlaywrightExecCommand(
          commands,
          skipped,
          'playwright-e2e-impact-tags',
          ['--grep', `(${e2eDecision.impactTags.join('|')})`],
          'run Playwright specs selected by impact tags',
        );
      }

      if (e2eDecision.specFilters.length > 0) {
        addPlaywrightExecCommand(
          commands,
          skipped,
          'playwright-e2e-spec-files',
          e2eDecision.specFilters,
          'run changed or mapped Playwright spec files',
        );
      }
    }
  }

  if (frontendConfigChanged) {
    addFrontendScriptCommand(commands, skipped, frontendScripts, 'build', 'frontend-build', 'frontend build metadata changed');
  }

  if (rustBackendChanged && pathExists('Cargo.toml')) {
    addCommand(commands, 'rust-format', 'cargo', ['fmt', '--all', '--check'], { reason: 'Rust backend files changed' });
    addCommand(commands, 'rust-check', 'cargo', ['check', '--workspace'], { reason: 'Rust backend files changed' });
    addCommand(commands, 'rust-tests', 'cargo', ['test', '--workspace'], { reason: 'Rust backend files changed' });
{% if backend_stack == 'rust' %}
    if (pathExists('scripts/check-rust-module-docs.sh')) {
      addCommand(commands, 'rust-module-docs', './scripts/check-rust-module-docs.sh', [], { reason: 'Rust backend files changed' });
    }
{% endif %}
  }

  if (dotnetBackendChanged && pathExists(dotnetSolutionPath)) {
    addCommand(commands, 'backend-format', 'dotnet', ['format', dotnetSolutionPath, '--verify-no-changes'], {
      reason: 'backend or solution files changed',
    });
    addCommand(commands, 'backend-build', 'dotnet', ['build', dotnetSolutionPath], {
      reason: 'backend or solution files changed',
    });
    addCommand(commands, 'backend-tests', 'dotnet', ['test', dotnetSolutionPath], {
      reason: 'backend or solution files changed',
    });
  }

  if (swiftSourceOrTestChanged) {
    if (includeSwiftFormat) {
      addCommand(commands, 'swift-format', './scripts/format.sh', ['--lint'], {
        reason: 'Swift product or XCTest source changed',
      });
    }
    if (includeSwiftLint && pathExists('scripts/lint-swiftlint.sh')) {
      addCommand(commands, 'swiftlint', './scripts/lint-swiftlint.sh', [], {
        reason: 'Swift product or XCTest source changed',
      });
    }
  }

  if ((swiftSourceOrTestChanged || xctestImpactGovernanceChanged) && includeXCTestImpactSelection) {
    addCommand(commands, 'xctest-impact-rules', 'node', ['scripts/validate-xctest-impact-rules.mjs', '--strict'], {
      reason: swiftSourceOrTestChanged ? 'Swift source changed before focused XCTest selection' : 'XCTest impact governance changed',
    });
  }

  if (swiftProjectMetadataChanged) {
    addCommand(commands, 'xcodegen', 'xcodegen', ['generate', '--spec', swiftProjectSpecPath], {
      reason: 'XcodeGen spec, Package.resolved, or Swift tool configuration changed',
    });
    addCommand(commands, 'test-bundle-build', 'node', ['scripts/build-for-testing.mjs'], {
      reason: 'Xcode project or package metadata changed',
    });
  }

  if (xctestImpact?.fullTargets.includes(swiftUnitTestTarget)) {
    addCommand(commands, 'swift-unit-tests', './scripts/test.mjs', ['unit'], {
      reason: xctestImpact.reasons.join('; '),
    });
  }
  const selectedUiIdentifiers =
    xctestImpact?.selectedIdentifiers.filter((identifier) => identifier.startsWith(`${swiftUiTestTarget}/`)) ?? [];
  const fullUiTargetSelected = xctestImpact?.fullTargets.includes(swiftUiTestTarget) ?? false;
  if (options.skipUiTests && (fullUiTargetSelected || selectedUiIdentifiers.length > 0 || swiftUiTestChanged)) {
    addSkip(
      skipped,
      'swift-ui-tests',
      'explicitly skipped by --skip-ui-tests; run the mapped UI selection when UI evidence is required',
    );
  } else if (fullUiTargetSelected) {
    addCommand(commands, 'swift-ui-tests', './scripts/test.mjs', ['ui'], {
      reason: xctestImpact.reasons.join('; '),
    });
  }
  if (xctestImpact?.selectedIdentifiers.length > 0) {
    addCommand(
      commands,
      'swift-selected-tests',
      './scripts/test.mjs',
      [
        'selected',
        ...(options.skipUiTests ? ['--skip-ui-tests'] : []),
        ...xctestImpact.selectedIdentifiers,
      ],
      { reason: xctestImpact.reasons.join('; ') },
    );
  } else if (swiftSourceOrTestChanged && !includeXCTestImpactSelection) {
    addCommand(commands, 'swift-unit-tests', './scripts/test.mjs', ['unit'], {
      reason: 'Swift changed and focused XCTest impact selection is disabled',
    });
    if (swiftUiTestChanged && !options.skipUiTests) {
      addCommand(commands, 'swift-ui-tests', './scripts/test.mjs', ['ui'], {
        reason: 'UI XCTest source changed and focused XCTest impact selection is disabled',
      });
    }
  }

  if (includeLayeringValidator && (rustBackendChanged || dotnetBackendChanged || frontendSourceChanged || swiftSourceOrTestChanged || layeringRulesChanged) && pathExists('scripts/validate-layering.mjs')) {
    addCommand(commands, 'architecture-layering', 'node', ['scripts/validate-layering.mjs'], {
      reason: 'source files or layering rules changed',
    });
  }

  if (includeApiContract && (contractFilesChanged || ((rustBackendChanged || dotnetBackendChanged) && contractFilesExist)) && pathExists('scripts/check-api-contract.sh')) {
    addCommand(commands, 'api-contract', './scripts/check-api-contract.sh', [], {
      reason: 'API contract inputs or backend files changed',
    });
  }

  if (governanceChanged && pathExists('scripts/validate-agent-governance.mjs')) {
    addCommand(commands, 'agent-governance', 'node', ['scripts/validate-agent-governance.mjs'], {
      reason: 'docs, agents, scripts, or workflows changed',
    });
  }

  if (specOrTraceabilityChanged && pathExists('scripts/validate-traceability-structure.mjs')) {
    addCommand(commands, 'traceability-structure', 'node', ['scripts/validate-traceability-structure.mjs', '--strict'], {
      reason: 'specs or traceability rules changed',
    });
  }

  if (markdownChanged && pathExists('scripts/lint-md.sh')) {
    addCommand(commands, 'markdown-lint', './scripts/lint-md.sh', [], { reason: 'markdown files changed' });
  }

  for (const scriptPath of nodeScriptsChanged) {
    if (pathExists(scriptPath)) {
      addCommand(commands, `node-syntax:${scriptPath}`, 'node', ['--check', scriptPath], {
        reason: 'Node script changed',
      });
    }
  }

  for (const scriptPath of shellScriptsChanged) {
    if (!pathExists(scriptPath)) {
      continue;
    }

    if (hasCommand('shellcheck')) {
      addCommand(commands, `shellcheck:${scriptPath}`, 'shellcheck', [scriptPath], {
        reason: 'shell script changed',
      });
    } else {
      addCommand(commands, `shell-syntax:${scriptPath}`, 'bash', ['-n', scriptPath], {
        reason: 'shell script changed',
      });
    }
  }

  if (playwrightImpactGovernanceChanged && pathExists('scripts/tests/validate-playwright-impact-tags-smoke.sh')) {
    addCommand(commands, 'playwright-impact-smoke', 'bash', ['scripts/tests/validate-playwright-impact-tags-smoke.sh'], {
      reason: 'Playwright impact governance changed',
    });
  }

  return { commands, skipped };
}

function printPlan(changedFiles, plan, options) {
  console.log('Changed-scope validation');
  console.log(`Changed files: ${changedFiles.length}`);
  if (options.skipE2e) {
    console.log('Playwright E2E execution: skipped by --skip-e2e');
  }
  if (options.skipUiTests) {
    console.log('iOS UI XCTest execution: skipped by --skip-ui-tests');
  }

  if (changedFiles.length === 0) {
    console.log('No changed files found.');
  }

  if (plan.commands.length === 0) {
    console.log('No checks selected.');
  } else {
    console.log('Selected checks:');
    for (const command of plan.commands) {
      console.log(`- ${command.label}: ${command.display}`);
      if (command.reason) {
        console.log(`  reason: ${command.reason}`);
      }
    }
  }

  if (plan.skipped.length > 0) {
    console.log('Skipped checks:');
    for (const skipped of plan.skipped) {
      console.log(`- ${skipped.label}: ${skipped.reason}`);
    }
  }
}

function runCommand(command) {
  console.log(`\n==> ${command.label}`);
  console.log(command.display);
  const result = spawnSync(command.command, command.args, {
    cwd: command.cwd,
    stdio: 'inherit',
  });

  if (result.error) {
    console.error(`${command.label}: ${result.error.message}`);
    return 1;
  }

  return result.status ?? 1;
}

function main() {
  let options;
  try {
    options = parseArgs(process.argv.slice(2));
  } catch (error) {
    console.error(error.message);
    console.error('Supported arguments: --since <git-ref>, --dry-run, --json, --skip-e2e, --skip-ui-tests, or explicit file paths');
    process.exit(1);
  }

  let changedFiles;
  let changes;
  let plan;
  try {
    changes = collectChanges(options);
    changedFiles = changedFilesFor(changes);
    plan = buildPlan(changedFiles, changes, options);
  } catch (error) {
    console.error(error.message);
    process.exit(1);
  }

  if (options.json) {
    console.log(
      JSON.stringify(
        {
          changedFiles,
          changes,
          commands: plan.commands.map((command) => ({
            args: command.args,
            command: command.display,
            cwd: toRepoRelative(command.cwd),
            label: command.label,
            reason: command.reason,
          })),
          dryRun: options.dryRun,
          skipE2e: options.skipE2e,
          skipUiTests: options.skipUiTests,
          skipped: plan.skipped,
        },
        null,
        2,
      ),
    );
    return;
  }

  printPlan(changedFiles, plan, options);

  if (options.dryRun || plan.commands.length === 0) {
    return;
  }

  for (const command of plan.commands) {
    const status = runCommand(command);
    if (status !== 0) {
      process.exit(status);
    }
  }

  console.log('\nChanged-scope validation passed.');
}

main();
