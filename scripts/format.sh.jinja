#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

print_stage() {
  printf '\n==> %s\n' "$1"
}

cd "${REPO_ROOT}"

{% if backend_stack == 'rust' -%}
print_stage "Rust format"
cargo fmt --all

{% elif backend_stack == 'dotnet' -%}
print_stage "Backend format"
dotnet format {{ dotnet_solution_path }}

{% endif -%}
{% if frontend_stack != 'none' -%}
print_stage "Frontend format"
pnpm --dir {{ frontend_dir }} format

{% endif -%}
print_stage "Formatting complete"
