#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

{% if backend_stack != 'none' -%}
API_HOST="${API_HOST:-{{ api_host }}}"
API_PORT="${API_PORT:-{{ api_port }}}"
API_BASE_URL="http://${API_HOST}:${API_PORT}"
{% endif -%}
{% if frontend_stack != 'none' -%}
FRONTEND_HOST="${FRONTEND_HOST:-{{ frontend_host }}}"
FRONTEND_PORT="${FRONTEND_PORT:-{{ frontend_port }}}"
FRONTEND_BASE_URL="http://${FRONTEND_HOST}:${FRONTEND_PORT}"
{% endif -%}
SMOKE_TIMEOUT_SECONDS="${SMOKE_TIMEOUT_SECONDS:-45}"
LOG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/{{ project_slug }}-smoke.XXXXXX")"

PIDS=()

check_port_free() {
  local label="$1"
  local port="$2"

  if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1; then
    printf '%s port %s is already in use. Smoke test will not kill unrelated processes.\n' "${label}" "${port}" >&2
    lsof -nP -iTCP:"${port}" -sTCP:LISTEN >&2
    exit 1
  fi
}

cleanup() {
  local pid

  for pid in "${PIDS[@]}"; do
    if kill -0 "${pid}" >/dev/null 2>&1; then
      kill "${pid}" >/dev/null 2>&1 || true
    fi
  done

  for pid in "${PIDS[@]}"; do
    wait "${pid}" >/dev/null 2>&1 || true
  done
}

show_logs() {
  :
{% if backend_stack != 'none' -%}
  printf '\nAPI log:\n' >&2
  tail -n 80 "${LOG_DIR}/api.log" >&2 || true
{% endif -%}
{% if frontend_stack != 'none' -%}
  printf '\nFrontend log:\n' >&2
  tail -n 80 "${LOG_DIR}/frontend.log" >&2 || true
{% endif -%}
}

fail() {
  printf '%s\n' "$1" >&2
  show_logs
  exit 1
}

ensure_alive() {
  local pid

  for pid in "${PIDS[@]}"; do
    if ! kill -0 "${pid}" >/dev/null 2>&1; then
      fail "A dev server exited before smoke checks completed."
    fi
  done
}

wait_for_text() {
  local label="$1"
  local url="$2"
  local expected="$3"
  local deadline=$((SECONDS + SMOKE_TIMEOUT_SECONDS))

  printf 'Waiting for %s: %s\n' "${label}" "${url}"

  while ((SECONDS < deadline)); do
    if curl --fail --silent --show-error "${url}" 2>/dev/null | grep --quiet "${expected}"; then
      printf '%s passed.\n' "${label}"
      return
    fi

    ensure_alive
    sleep 1
  done

  fail "${label} did not become ready within ${SMOKE_TIMEOUT_SECONDS}s."
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

{% if backend_stack != 'none' -%}
check_port_free "API" "${API_PORT}"
{% endif -%}
{% if frontend_stack != 'none' -%}
check_port_free "Frontend" "${FRONTEND_PORT}"
{% endif %}

printf 'Smoke logs: %s\n' "${LOG_DIR}"

{% if backend_stack == 'rust' -%}
(
  cd "${REPO_ROOT}"
  PORT="${API_PORT}" \
    RUST_LOG="${RUST_LOG:-{{ project_slug | replace('-', '_') }}_api=debug,tower_http=info}" \
    exec cargo run -p {{ rust_api_package }}
) >"${LOG_DIR}/api.log" 2>&1 &
PIDS+=("$!")

{% elif backend_stack == 'dotnet' -%}
(
  cd "${REPO_ROOT}"
  ASPNETCORE_ENVIRONMENT=Development \
    ASPNETCORE_URLS="${API_BASE_URL}" \
    exec dotnet run --project "{{ dotnet_api_project_path }}"
) >"${LOG_DIR}/api.log" 2>&1 &
PIDS+=("$!")

{% endif -%}
{% if frontend_stack == 'vite' -%}
(
  cd "${REPO_ROOT}"
{% if backend_stack != 'none' -%}
  VITE_API_BASE_URL="${API_BASE_URL}" \
{% endif -%}
    exec pnpm --dir {{ frontend_dir }} dev --host "${FRONTEND_HOST}" --port "${FRONTEND_PORT}"
) >"${LOG_DIR}/frontend.log" 2>&1 &
PIDS+=("$!")

{% elif frontend_stack == 'astro' -%}
(
  cd "${REPO_ROOT}"
{% if backend_stack != 'none' -%}
  PUBLIC_API_BASE_URL="${API_BASE_URL}" \
{% endif -%}
    exec pnpm --dir {{ frontend_dir }} exec astro dev --host "${FRONTEND_HOST}" --port "${FRONTEND_PORT}"
) >"${LOG_DIR}/frontend.log" 2>&1 &
PIDS+=("$!")

{% endif -%}
{% if backend_stack != 'none' -%}
wait_for_text "API health" "${API_BASE_URL}{{ api_health_path }}" "{{ api_health_text }}"
{% endif -%}
{% if frontend_stack != 'none' -%}
wait_for_text "Frontend home" "${FRONTEND_BASE_URL}/" "{{ frontend_health_text }}"
{% endif -%}
{% if include_api_contract | default(false) and backend_stack == 'rust' -%}
wait_for_text "OpenAPI" "${API_BASE_URL}/openapi.json" "openapi"
{% endif %}

printf 'Runtime smoke checks passed.\n'
