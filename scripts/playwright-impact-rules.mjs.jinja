//     sourcePatterns: [/^{{ impact_frontend_dir_regex }}\/src\/features\/export\//],
//     e2ePatterns: [/^{{ impact_e2e_test_dir_regex }}\/export-.*\.spec\.ts$/],
//   },
// ];
export const impactTagRules = [];

export const fullE2eTriggerPatterns = [
  /^{{ impact_frontend_dir_regex }}\/package(?:-lock)?\.json$/,
  /^{{ impact_frontend_dir_regex }}\/pnpm-lock\.yaml$/,
  /^{{ impact_frontend_dir_regex }}\/playwright\.config\./,
  /^{{ impact_frontend_dir_regex }}\/vite\.config\./,
  /^{{ impact_frontend_dir_regex }}\/astro\.config\./,
];
